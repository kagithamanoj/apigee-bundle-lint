<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>Spike-Arrest</Name>
      </Step>
      <Step>
        <Name>Ghost-Policy</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <HTTPProxyConnection>
    <BasePath>v1/broken</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="catch-all">
    <TargetEndpoint>nowhere</TargetEndpoint>
  </RouteRule>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
